generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empleado {
  dni                Int       @id
  nombreApellido     String    @map("nombre_apellido") @db.VarChar(60)
  telefono           String?   @db.VarChar(20)
  puesto             String    @db.VarChar(30)
  accesoSistema      Boolean   @default(false) @map("acceso_sistema")
  usuario            String?   @unique @db.VarChar(20)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  metricaAsistencias Decimal   @default(0) @map("metrica_asistencias") @db.Decimal(5, 2)

  ventas  Venta[]
  cierres CierreCaja[]

  @@map("empleado")
}

model Proveedor {
  cuit            String  @id @db.VarChar(13)
  razonSocial     String  @map("razon_social") @db.VarChar(60)
  direccion       String? @db.VarChar(80)
  contacto        String? @db.VarChar(60)
  condicionesPago String? @map("condiciones_pago") @db.VarChar(80)

  provisorio  ProveedorProvisorio?
  suministros Suministro[]

  @@map("proveedor")
}

model ProveedorProvisorio {
  cuit                String    @id @db.VarChar(13)
  fechaVencProvisorio DateTime @map("fecha_venc_provisorio") @db.Date
  motivo              String    @db.VarChar(80)
  proveedor           Proveedor @relation(fields: [cuit], references: [cuit], onDelete: Cascade)

  @@map("proveedor_provisorio")
}

model ElementoStock {
  idProducto     Int       @id @default(autoincrement()) @map("id_producto")
  nombre         String    @db.VarChar(60)
  tipoCategoria  String?   @map("tipo_categoria") @db.VarChar(30)
  precio         Decimal   @default(0) @db.Decimal(10, 2)
  cantidadActual Decimal   @default(0) @map("cantidad_actual") @db.Decimal(8, 2)
  cantidadMaxima Decimal   @map("cantidad_maxima") @db.Decimal(8, 2)
  stockMinimo    Decimal   @default(0) @map("stock_minimo") @db.Decimal(8, 2)
  unidadMedida   String    @map("unidad_medida") @db.VarChar(15)

  fabricado    ElementoFabricado?
  materiaPrima MateriaPrima?

  @@map("elemento_stock")
}

model ElementoFabricado {
  idProducto              Int       @id @map("id_producto")
  fechaConsumoRecomendada DateTime? @map("fecha_consumo_recomendada") @db.Date
  stock                   ElementoStock @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  receta   Receta[]
  detalles DetalleVenta[]

  @@map("elemento_fabricado")
}

model MateriaPrima {
  idProducto     Int       @id @map("id_producto")
  fechaCaducidad DateTime? @map("fecha_caducidad") @db.Date
  stock          ElementoStock @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  usadaEn     Receta[]
  suministros Suministro[]

  @@map("materia_prima")
}

model CierreCaja {
  idCierre Int      @id @default(autoincrement()) @map("id_cierre")
  fecha    DateTime @db.Date
  turno    String   @db.VarChar(15)
  dni    Int
  empleado Empleado @relation(fields: [dni], references: [dni], onDelete: Restrict)

  ventas Venta[]

  @@map("cierre_caja")
}

model Venta {
  nroVenta    BigInt   @id @default(autoincrement()) @map("nro_venta")
  fecha       DateTime @db.Date
  precioFinal Decimal  @default(0) @map("precio_final") @db.Decimal(10, 2)
  canalVenta  String   @map("canal_venta") @db.VarChar(20)
  dni         Int
  idCierre    Int      @map("id_cierre")

  empleado Empleado   @relation(fields: [dni], references: [dni], onDelete: Restrict)
  cierre   CierreCaja @relation(fields: [idCierre], references: [idCierre], onDelete: Restrict)
  detalle  DetalleVenta[]

  @@index([fecha])
  @@index([idCierre])
  @@index([dni])
  @@map("venta")
}

model DetalleVenta {
  nroVenta         BigInt  @map("nro_venta")
  idProducto       Int     @map("id_producto")
  cantidad         Decimal @db.Decimal(6, 2)
  precioIndividual Decimal @map("precio_individual") @db.Decimal(10, 2)

  venta    Venta             @relation(fields: [nroVenta], references: [nroVenta], onDelete: Cascade)
  producto ElementoFabricado @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict)

  @@id([nroVenta, idProducto])
  @@map("detalle_venta")
}

model Receta {
  idProducto        Int     @map("id_producto")
  idMateriaPrima    Int     @map("id_materia_prima")
  cantidadNecesaria Decimal @map("cantidad_necesaria") @db.Decimal(8, 2)

  producto     ElementoFabricado @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)
  materiaPrima MateriaPrima      @relation(fields: [idMateriaPrima], references: [idProducto], onDelete: Restrict)

  @@id([idProducto, idMateriaPrima])
  @@map("receta")
}

model Suministro {
  cuit           String  @db.VarChar(13)
  idProducto     Int     @map("id_producto")
  precioAcordado Decimal @map("precio_acordado") @db.Decimal(10, 2)

  proveedor    Proveedor    @relation(fields: [cuit], references: [cuit], onDelete: Cascade)
  materiaPrima MateriaPrima @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  @@id([cuit, idProducto])
  @@map("suministro")
}