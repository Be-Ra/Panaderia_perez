# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL >= 15. Si no tenés Postgres, dejalo como está — podés entrar
# al sistema igual usando el superusuario de abajo.
DATABASE_URL="postgresql://user:password@localhost:5432/panes_y_gestion"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-cambiar-en-produccion"

# ── Superusuario (funciona sin base de datos) ─────────────────────────────────
# Entrá con estas credenciales directamente en el login.
# Rol: gerente (acceso total a todas las secciones).
# ⚠️  Cambiar la contraseña antes de usar en producción.
SUPERUSER_USER="admin"
SUPERUSER_PASSWORD="admin1234"
